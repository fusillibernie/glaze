  "oxide_roles": {
    "SiO2": {
      "name": "Silica",
      "role": "glass_former",
      "effects": "Forms glass structure, increases melting point, reduces thermal expansion"
    },
    "Al2O3": {
      "name": "Alumina",
      "role": "intermediate",
      "effects": "Increases viscosity, prevents crystallization, improves durability"
    },
    "B2O3": {
      "name": "Boron",
      "role": "flux",
      "effects": "Lowers melting point, essential at cone 6, reduces thermal expansion"
    },
    "KNaO": {
      "name": "Alkalis (K2O + Na2O)",
      "role": "flux",
      "effects": "Strong flux, increases thermal expansion (crazing risk)"
    },
    "CaO": {
      "name": "Calcium",
      "role": "flux",
      "effects": "Primary high-temp flux, promotes hardness, reduces crazing"
    },
    "MgO": {
      "name": "Magnesia",
      "role": "flux",
      "effects": "High-temp flux, promotes smooth buttery surface, can cause crawling if too high"
    },
    "ZnO": {
      "name": "Zinc",
      "role": "flux",
      "effects": "Active flux, promotes crystallization, can cause crawling"
    },
    "BaO": {
      "name": "Barium",
      "role": "flux",
      "effects": "Promotes crystal development in mattes, toxic if soluble"
    },
    "Li2O": {
      "name": "Lithium",
      "role": "flux",
      "effects": "Powerful flux, reduces thermal expansion, promotes color development"
    },
    "SrO": {
      "name": "Strontium",
      "role": "flux",
      "effects": "Similar to calcium but promotes smoother surfaces, less common"
    }
  }
