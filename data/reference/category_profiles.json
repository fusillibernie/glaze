    "chun": {
      "description": "Opalescent blue from liquid-liquid phase separation - submicron glass droplets Rayleigh-scatter short wavelengths. The blue is optical, not pigmented: there is no blue colorant in the glaze.",
      "preferred_atmosphere": [
        "reduction"
      ],
      "surface": "glossy",
      "umf_overrides": {
        "SiO2": {
          "min": 3.3,
          "max": 4.3
        },
        "Al2O3": {
          "min": 0.27,
          "max": 0.36
        },
        "CaO": {
          "min": 0.45,
          "max": 0.7
